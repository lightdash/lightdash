#!/usr/bin/env python3
import fcntl
import os
import sys
from pathlib import Path

root=Path(__file__).resolve().parent
work=root/'.work'
work.mkdir(exist_ok=True)
lock=(work/'run.lock').open('a')
try:
    fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit('A fixture runner is already active in this worktree.')
os.set_inheritable(lock.fileno(),True)
python=work/'venvs/dbt12/bin/python'
os.execv(python,[str(python),'-u',str(root/'run.py'),'--dbt19',str(work/'venvs/dbt19/bin/dbt'),*sys.argv[1:]])
