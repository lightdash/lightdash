FROM merge_0_a
FULL OUTER JOIN merge_1_b ON merge_0_a.\`order_date\` = merge_1_b.\`order_date\`
),
merge_spine AS (
SELECT explode(sequence(
    (SELECT MIN(\`order_date\`) FROM merge_rows),
