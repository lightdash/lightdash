// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`per-dialect compile snapshots > compiles a FULL join on a nullable timestamp key on bigquery 1`] = `
"WITH merge_0_a AS (
SELECT created_at, 1 AS new_organic FROM followers GROUP BY 1
),
merge_1_b AS (
SELECT created_at, 2 AS total_followers FROM follower_snapshots GROUP BY 1
)
SELECT COALESCE(merge_0_a.\`created_at\`, merge_1_b.\`created_at\`) AS \`created_at\`,
       merge_0_a.\`new_organic\` AS \`c0_0\`,
       merge_1_b.\`total_followers\` AS \`c1_0\`
FROM merge_0_a
FULL OUTER JOIN merge_1_b ON (merge_0_a.\`created_at\` IS NULL) = (merge_1_b.\`created_at\` IS NULL) AND COALESCE(merge_0_a.\`created_at\`, TIMESTAMP('1970-01-01T00:00:00.000Z')) = COALESCE(merge_1_b.\`created_at\`, TIMESTAMP('1970-01-01T00:00:00.000Z'))
ORDER BY \`created_at\`"
`;

