exports[`per-dialect compile snapshots > date-spine fill > fills a date key at DAY grain on bigquery 1`] = `
"WITH merge_0_a AS (
SELECT order_date, 1 AS new_organic FROM followers GROUP BY 1
),
merge_1_b AS (
SELECT order_date, 2 AS total_followers FROM follower_snapshots GROUP BY 1
),
merge_rows AS (
SELECT COALESCE(merge_0_a.\`order_date\`, merge_1_b.\`order_date\`) AS \`order_date\`,
       merge_0_a.\`new_organic\` AS \`c0_0\`,
       merge_1_b.\`total_followers\` AS \`c1_0\`
FROM merge_0_a
FULL OUTER JOIN merge_1_b ON merge_0_a.\`order_date\` = merge_1_b.\`order_date\`
),
merge_spine AS (
SELECT d AS \`order_date\`
FROM UNNEST(GENERATE_DATE_ARRAY(
    (SELECT MIN(\`order_date\`) FROM merge_rows),
    (SELECT MAX(\`order_date\`) FROM merge_rows),
    INTERVAL 1 DAY
)) AS d
)
SELECT COALESCE(merge_spine.\`order_date\`, merge_rows.\`order_date\`) AS \`order_date\`,
       merge_rows.\`c0_0\`,
       merge_rows.\`c1_0\`
FROM merge_spine
FULL OUTER JOIN merge_rows ON merge_spine.\`order_date\` = merge_rows.\`order_date\`"
`;

exports[`per-dialect compile snapshots > date-spine fill > fills a date key at DAY grain on databricks 1`] = `
"WITH merge_0_a AS (
SELECT order_date, 1 AS new_organic FROM followers GROUP BY 1
),
merge_1_b AS (
SELECT order_date, 2 AS total_followers FROM follower_snapshots GROUP BY 1
),
merge_rows AS (
SELECT COALESCE(merge_0_a.\`order_date\`, merge_1_b.\`order_date\`) AS \`order_date\`,
       merge_0_a.\`new_organic\` AS \`c0_0\`,
       merge_1_b.\`total_followers\` AS \`c1_0\`
FROM merge_0_a
FULL OUTER JOIN merge_1_b ON merge_0_a.\`order_date\` = merge_1_b.\`order_date\`
),
merge_spine AS (
SELECT explode(sequence(
    (SELECT MIN(\`order_date\`) FROM merge_rows),
    (SELECT MAX(\`order_date\`) FROM merge_rows),
    INTERVAL '1' DAY
)) AS \`order_date\`
)
SELECT COALESCE(merge_spine.\`order_date\`, merge_rows.\`order_date\`) AS \`order_date\`,
       merge_rows.\`c0_0\`,
       merge_rows.\`c1_0\`
FROM merge_spine
FULL OUTER JOIN merge_rows ON merge_spine.\`order_date\` = merge_rows.\`order_date\`"
`;

exports[`per-dialect compile snapshots > date-spine fill > fills a date key at DAY grain on duckdb 1`] = `
"WITH merge_0_a AS (
SELECT order_date, 1 AS new_organic FROM followers GROUP BY 1
),
merge_1_b AS (
SELECT order_date, 2 AS total_followers FROM follower_snapshots GROUP BY 1
),
merge_rows AS (
SELECT COALESCE(merge_0_a."order_date", merge_1_b."order_date") AS "order_date",
       merge_0_a."new_organic" AS "c0_0",
       merge_1_b."total_followers" AS "c1_0"
FROM merge_0_a
FULL OUTER JOIN merge_1_b ON merge_0_a."order_date" = merge_1_b."order_date"
),
merge_spine AS (
SELECT unnest(generate_series(
    (SELECT MIN("order_date") FROM merge_rows),
    (SELECT MAX("order_date") FROM merge_rows),
    INTERVAL '1 day'
)) AS "order_date"
)
SELECT COALESCE(merge_spine."order_date", merge_rows."order_date") AS "order_date",
       merge_rows."c0_0",
       merge_rows."c1_0"
FROM merge_spine
FULL OUTER JOIN merge_rows ON merge_spine."order_date" = merge_rows."order_date""
`;

exports[`per-dialect compile snapshots > date-spine fill > fills a date key at DAY grain on postgres 1`] = `
"WITH merge_0_a AS (
SELECT order_date, 1 AS new_organic FROM followers GROUP BY 1
),
merge_1_b AS (
SELECT order_date, 2 AS total_followers FROM follower_snapshots GROUP BY 1
),
merge_rows AS (
SELECT COALESCE(merge_0_a."order_date", merge_1_b."order_date") AS "order_date",
       merge_0_a."new_organic" AS "c0_0",
       merge_1_b."total_followers" AS "c1_0"
FROM merge_0_a
FULL OUTER JOIN merge_1_b ON merge_0_a."order_date" = merge_1_b."order_date"
),
merge_spine AS (
SELECT generate_series(
    (SELECT MIN("order_date") FROM merge_rows),
    (SELECT MAX("order_date") FROM merge_rows),
    INTERVAL '1 day'
)::date AS "order_date"
)
SELECT COALESCE(merge_spine."order_date", merge_rows."order_date") AS "order_date",
       merge_rows."c0_0",
       merge_rows."c1_0"
FROM merge_spine
FULL OUTER JOIN merge_rows ON merge_spine."order_date" = merge_rows."order_date""
`;

exports[`per-dialect compile snapshots > date-spine fill > fills a date key at DAY grain on snowflake 1`] = `
"WITH merge_0_a AS (
SELECT order_date, 1 AS new_organic FROM followers GROUP BY 1
),
merge_1_b AS (
SELECT order_date, 2 AS total_followers FROM follower_snapshots GROUP BY 1
),
merge_rows AS (
SELECT COALESCE(merge_0_a."order_date", merge_1_b."order_date") AS "order_date",
       merge_0_a."new_organic" AS "c0_0",
       merge_1_b."total_followers" AS "c1_0"
FROM merge_0_a
FULL OUTER JOIN merge_1_b ON merge_0_a."order_date" = merge_1_b."order_date"
),
merge_spine AS (
SELECT DATEADD(day, ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1, (SELECT MIN("order_date") FROM merge_rows)) AS "order_date"
FROM TABLE(GENERATOR(ROWCOUNT => 50000))
QUALIFY "order_date" <= (SELECT MAX("order_date") FROM merge_rows)
)
SELECT COALESCE(merge_spine."order_date", merge_rows."order_date") AS "order_date",
       merge_rows."c0_0",
       merge_rows."c1_0"
FROM merge_spine
FULL OUTER JOIN merge_rows ON merge_spine."order_date" = merge_rows."order_date""
`;

exports[`per-dialect compile snapshots > date-spine fill > fills a date key at DAY grain on trino 1`] = `
"WITH merge_0_a AS (
SELECT order_date, 1 AS new_organic FROM followers GROUP BY 1
),
merge_1_b AS (
SELECT order_date, 2 AS total_followers FROM follower_snapshots GROUP BY 1
),
merge_rows AS (
SELECT COALESCE(merge_0_a."order_date", merge_1_b."order_date") AS "order_date",
       merge_0_a."new_organic" AS "c0_0",
       merge_1_b."total_followers" AS "c1_0"
FROM merge_0_a
FULL OUTER JOIN merge_1_b ON merge_0_a."order_date" = merge_1_b."order_date"
),
merge_spine AS (
SELECT s AS "order_date"
FROM UNNEST(sequence(
    (SELECT MIN("order_date") FROM merge_rows),
    (SELECT MAX("order_date") FROM merge_rows),
    INTERVAL '1' DAY
)) AS t (s)
)
SELECT COALESCE(merge_spine."order_date", merge_rows."order_date") AS "order_date",
       merge_rows."c0_0",
       merge_rows."c1_0"
FROM merge_spine
FULL OUTER JOIN merge_rows ON merge_spine."order_date" = merge_rows."order_date""
`;

