// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ordinary array matches main SQL 1`] = `
[
  "BEGIN;",
  "insert into "cached_explores" ("explores", "project_uuid") values ($1, $2) on conflict ("project_uuid") do nothing",
  "select * from "cached_explores" where "project_uuid" = $1 limit $2 for update",
  "select "explore" from "cached_explore" where "project_uuid" = $1 and explore->>'type' = ANY($2)",
  "delete from "cached_explore" where "project_uuid" = $1 and "name" not in ($2)",
  "insert into "cached_explore" ("explore", "name", "project_uuid", "table_names") values ($1, $2, $3, $4) on conflict ("name", "project_uuid") do update set "table_names" = excluded."table_names", "explore" = excluded."explore", "warehouse_connection_uuid" = excluded."warehouse_connection_uuid" returning "cached_explore_uuid"",
  "COMMIT;",
]
`;

exports[`ordinary multi matches main SQL 1`] = `
[
  "insert into "cached_explore_staging" ("explore", "name", "project_uuid", "save_uuid", "table_names", "warehouse_connection_uuid") values ($1, $2, $3, $4, $5, $6) on conflict ("save_uuid", "name", "project_uuid") do update set "table_names" = excluded."table_names", "explore" = excluded."explore"",
  "BEGIN;",
  "insert into "cached_explores" ("explores", "project_uuid") values ($1, $2) on conflict ("project_uuid") do nothing",
  "select * from "cached_explores" where "project_uuid" = $1 limit $2 for update",
  "INSERT INTO "cached_explore_staging" (save_uuid, project_uuid, name, table_names, explore, warehouse_connection_uuid)
                                 SELECT $1, project_uuid, name, table_names, explore, warehouse_connection_uuid
                                 FROM "cached_explore"
                                 WHERE project_uuid = $2
                                   AND explore->>'type' = ANY($3)
                                 ON CONFLICT (save_uuid, name, project_uuid) DO UPDATE
                                 SET table_names = EXCLUDED.table_names,
                                     explore = EXCLUDED.explore,
                                     warehouse_connection_uuid = EXCLUDED.warehouse_connection_uuid
                                 RETURNING name",
  "select "name" from "cached_explore_staging" where "save_uuid" = $1 and "project_uuid" = $2 for update",
  "delete from "cached_explore" where "project_uuid" = $1 and not exists (select 1 from "cached_explore_staging" where "save_uuid" = $2 and "project_uuid" = $3 and "cached_explore_staging".name = "cached_explore".name)",
  "INSERT INTO "cached_explore" (cached_explore_uuid, project_uuid, name, table_names, explore, warehouse_connection_uuid)
                                 SELECT cached_explore_uuid, project_uuid, name, table_names, explore, warehouse_connection_uuid
                                 FROM "cached_explore_staging"
                                 WHERE save_uuid = $1 AND project_uuid = $2
                                 ON CONFLICT (name, project_uuid) DO UPDATE
                                 SET table_names = EXCLUDED.table_names,
                                     explore = EXCLUDED.explore,
                                     warehouse_connection_uuid = EXCLUDED.warehouse_connection_uuid
                                 RETURNING name, cached_explore_uuid",
  "COMMIT;",
  "delete from "cached_explore_staging" where "save_uuid" = $1",
]
`;

exports[`ordinary parameters matches main SQL 1`] = `
[
  "select "projects"."name", "projects"."slug", "projects"."project_type", "projects"."dbt_connection", "warehouse_credentials"."encrypted_credentials", "warehouse_credentials"."warehouse_type", "organizations"."organization_uuid", "pinned_list"."pinned_list_uuid", "projects"."dbt_version", "projects"."copied_from_project_uuid", "projects"."scheduler_timezone", "projects"."query_timezone", "projects"."use_project_timezone_in_filters", "projects"."scheduler_failure_notify_recipients", "projects"."scheduler_failure_include_contact", "projects"."scheduler_failure_contact_override", "projects"."created_by_user_uuid", "projects"."organization_warehouse_credentials_uuid", "projects"."has_default_user_spaces", "projects"."project_defaults", "projects"."color_palette_uuid", "projects"."expires_at", "projects"."provisioning_source", "projects"."agent_sql_scope", "projects"."connection_mode" from "projects" left join "warehouse_credentials" on "warehouse_credentials"."project_id" = "projects"."project_id" left join "organizations" on "organizations"."organization_id" = "projects"."organization_id" left join "pinned_list" on "pinned_list"."project_uuid" = "projects"."project_uuid" where "projects"."project_uuid" = $1",
  "BEGIN;",
  "delete from "project_parameters" where "project_uuid" = $1",
  "insert into "project_parameters" ("config", "name", "project_uuid") values ($1, $2, $3) returning *",
  "COMMIT;",
]
`;

exports[`ordinary stream matches main SQL 1`] = `
[
  "insert into "cached_explore_staging" ("explore", "name", "project_uuid", "save_uuid", "table_names") values ($1, $2, $3, $4, $5) on conflict ("save_uuid", "name", "project_uuid") do update set "table_names" = excluded."table_names", "explore" = excluded."explore"",
  "BEGIN;",
  "insert into "cached_explores" ("explores", "project_uuid") values ($1, $2) on conflict ("project_uuid") do nothing",
  "select * from "cached_explores" where "project_uuid" = $1 limit $2 for update",
  "INSERT INTO "cached_explore_staging" (save_uuid, project_uuid, name, table_names, explore)
                                 SELECT $1, project_uuid, name, table_names, explore
                                 FROM "cached_explore"
                                 WHERE project_uuid = $2
                                   AND explore->>'type' = ANY($3)
                                 ON CONFLICT (save_uuid, name, project_uuid) DO UPDATE
                                 SET table_names = EXCLUDED.table_names,
                                     explore = EXCLUDED.explore
                                 RETURNING name, cached_explore_uuid",
  "select "name" from "cached_explore_staging" where "save_uuid" = $1 and "project_uuid" = $2 for update",
  "delete from "cached_explore" where "project_uuid" = $1 and not exists (select 1 from "cached_explore_staging" where "save_uuid" = $2 and "project_uuid" = $3 and "cached_explore_staging".name = "cached_explore".name)",
  "INSERT INTO "cached_explore" (cached_explore_uuid, project_uuid, name, table_names, explore)
                                 SELECT cached_explore_uuid, project_uuid, name, table_names, explore
                                 FROM "cached_explore_staging"
                                 WHERE save_uuid = $1 AND project_uuid = $2
                                 ON CONFLICT (name, project_uuid) DO UPDATE
                                 SET table_names = EXCLUDED.table_names,
                                     explore = EXCLUDED.explore,
                                     warehouse_connection_uuid = NULL
                                 RETURNING name, cached_explore_uuid",
  "COMMIT;",
  "delete from "cached_explore_staging" where "save_uuid" = $1",
  "delete from "cached_explore_staging" where "save_uuid" in (select "save_uuid" from "cached_explore_staging" group by "save_uuid" having max(created_at) < now() - interval '24 hours' limit $1)",
]
`;

exports[`ordinary virtual-create matches main SQL 1`] = `
[
  "select "projects"."name", "projects"."project_uuid", "projects"."slug", "organizations"."organization_uuid", "projects"."copied_from_project_uuid", "projects"."project_type", "projects"."created_by_user_uuid", "projects"."provisioning_source" from "projects" left join "organizations" on "projects"."organization_id" = "organizations"."organization_id" where "projects"."project_uuid" = $1 limit $2",
  "select "explore", "cached_explore_uuid" from "cached_explore" where "project_uuid" = $1 and "name" in ($2)",
  "BEGIN;",
  "insert into "cached_explores" ("explores", "project_uuid") values ($1, $2) on conflict ("project_uuid") do nothing",
  "select * from "cached_explores" where "project_uuid" = $1 limit $2 for update",
  "select "name" from "cached_explore" where "project_uuid" = $1 and "name" = $2 limit $3",
  "insert into "cached_explore" ("explore", "name", "project_uuid", "table_names", "warehouse_connection_uuid") values ($1, $2, $3, $4, $5)",
  "COMMIT;",
]
`;

exports[`ordinary virtual-update matches main SQL 1`] = `
[
  "select "explore", "cached_explore_uuid" from "cached_explore" where "project_uuid" = $1 and "name" in ($2)",
  "select "projects"."name", "projects"."project_uuid", "projects"."slug", "organizations"."organization_uuid", "projects"."copied_from_project_uuid", "projects"."project_type", "projects"."created_by_user_uuid", "projects"."provisioning_source" from "projects" left join "organizations" on "projects"."organization_id" = "organizations"."organization_id" where "projects"."project_uuid" = $1 limit $2",
  "select "warehouse_connection_uuid" from "cached_explore" where "project_uuid" = $1 and "name" = $2 limit $3",
  "BEGIN;",
  "insert into "cached_explores" ("explores", "project_uuid") values ($1, $2) on conflict ("project_uuid") do nothing",
  "select * from "cached_explores" where "project_uuid" = $1 limit $2 for update",
  "select "explore" from "cached_explore" where "project_uuid" = $1 and "name" = $2 limit $3",
  "update "cached_explore" set "table_names" = $1, "explore" = $2 where "project_uuid" = $3 and "name" = $4",
  "COMMIT;",
]
`;
