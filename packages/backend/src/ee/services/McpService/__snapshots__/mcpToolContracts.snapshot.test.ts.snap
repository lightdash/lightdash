                                  "const": "notNull",
                                  "type": "string",
                                },
                              ],
                              "description": "Use isNull for missing values, notNull for present values.",
                            },
                          },
                          "required": [
                            "fieldId",
                            "fieldType",
                            "fieldFilterType",
                            "operator",
                          ],
                          "type": "object",
                        },
