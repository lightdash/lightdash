              "fields",
              "status",
              "queryUuid",
              "exploreUrl",
            ],
            "type": "object",
          },
          {
            "additionalProperties": false,
            "properties": {
              "heartbeatAt": {
                "description": "ISO timestamp for when Lightdash last checked this async query and confirmed it is still running.",
                "type": "string",
              },
