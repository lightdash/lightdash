          ],
        },
        "__schema100": {
          "const": false,
          "description": "Always false for current-period filters.",
          "type": "boolean",
        },
        "__schema101": {
          "anyOf": [
            {
              "$ref": "#/definitions/__schema102",
            },
            {
              "$ref": "#/definitions/__schema103",
            },
            {
