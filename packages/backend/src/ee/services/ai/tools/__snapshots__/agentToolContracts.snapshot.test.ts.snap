                "spaceSlug",
                "version",
                "contentType",
                "verified",
                "tiles",
                "tabs",
              ],
              "type": "object",
            },
            {
              "additionalProperties": {},
              "description": "Full Chart JSON to create.",
              "properties": {
                "chartConfig": {},
                "contentType": {
                  "type": "string",
                },
                "dashboardSlug": {
                  "type": "string",
                },
                "description": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "downloadedAt": {},
