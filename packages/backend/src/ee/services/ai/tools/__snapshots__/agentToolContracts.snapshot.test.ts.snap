                },
                "updatedAt": {},
                "verification": {},
                "verified": {
                  "type": "boolean",
                },
                "version": {
                  "type": "number",
                },
              },
              "required": [
                "slug",
                "name",
                "description",
                "spaceSlug",
                "version",
                "contentType",
                "verified",
                "tableName",
                "metricQuery",
                "dashboardSlug",
