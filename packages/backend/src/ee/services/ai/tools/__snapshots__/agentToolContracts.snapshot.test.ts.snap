          "description": "The latest user question or instruction the agent is responding to. Pass the full message — the subagent uses it to disambiguate explores and rank fields.",
          "type": "string",
        },
      },
      "required": [
        "userQuery",
        "agentInstruction",
      ],
      "type": "object",
    },
    "name": "discoverFields",
    "outputSchema": {
