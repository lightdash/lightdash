  {
    "description": "Tool: searchSemanticLayer

Purpose:
Search or list metrics and dimensions across every explore at once, as one flat, paginated inventory, so you can compare names, labels and descriptions across the whole project: an inventory, duplicate or confusingly similar metrics, which explores define a "revenue" metric. To find the fields that answer a data question, use grepFields, which groups matches by explore.
",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "page": {
          "description": "Paginate results starting at 1. Pass a positive number (e.g. 1), never NaN or the string "null".",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null",
          ],
        },
        "pageSize": {
          "description": "Fields per page (default 200, max 500); null for the default. The result reports totals across all pages. For an overview, the first page and those totals are usually enough; read every page only when the task needs every field, such as a project-wide duplicate audit, with a large pageSize so it takes one or two calls.",
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null",
          ],
        },
        "searchQuery": {
          "description": "Keyword to full-text search field names, labels and descriptions across all explores. Null or empty returns the full inventory.",
          "type": [
            "string",
            "null",
          ],
        },
        "type": {
          "description": "Return only metrics or only dimensions; null returns both.",
          "enum": [
            "metric",
            "dimension",
            null,
          ],
          "type": [
            "string",
            "null",
          ],
        },
      },
      "required": [
        "searchQuery",
        "type",
        "pageSize",
        "page",
      ],
      "type": "object",
    },
    "name": "searchSemanticLayer",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "metadata": {
              "allOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "ranking": {
                      "additionalProperties": false,
                      "properties": {
                        "fields": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "chartUsage": {
                                "anyOf": [
                                  {
                                    "type": "number",
                                  },
                                  {
                                    "type": "null",
                                  },
                                ],
                              },
                              "fieldType": {
                                "type": "string",
                              },
                              "label": {
                                "type": "string",
                              },
                              "name": {
                                "type": "string",
                              },
                              "searchRank": {
                                "anyOf": [
                                  {
                                    "type": "number",
                                  },
                                  {
                                    "type": "null",
                                  },
                                ],
                              },
                              "tableName": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "name",
                              "label",
                              "tableName",
                              "fieldType",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
