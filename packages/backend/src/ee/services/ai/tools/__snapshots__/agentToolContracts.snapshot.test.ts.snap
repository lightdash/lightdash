          "description": "Keyword terms matched against custom chart type names and descriptions. Set exactly one of query or slug.",
          "type": [
            "string",
            "null",
          ],
        },
        "slug": {
          "description": "Exact slug of one custom chart type, from the listed types or a previous search. Set exactly one of query or slug.",
          "type": [
            "string",
            "null",
          ],
        },
      },
      "type": "object",
    },
