exports[`AI agent tool contracts > matches the current agent tool contract snapshot 1`] = `
[
  {
    "description": "Return the column names and types of one raw, staging or seed table that no explore exposes. It reads cached metadata, so it is fast and needs no approval, and returns schema only, not data.

- Before writing raw SQL against such a table, call it to confirm the columns you need exist, such as a join key.
- After a "column does not exist" or "relation not found" error, call it for the real columns, then rewrite the SQL once instead of guessing again.
- When the columns show that the relationship you need does not exist (no foreign key, no junction table), stop and tell the user what you expected and what the table has, then offer a proxy or ask for the right table.

For explore-backed tables use grepFields and getMetadata; to find a table's name use listWarehouseTables.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "database": {
          "description": "Database or catalog from listWarehouseTables, for a table outside the default database. Omit for the project's default database.",
          "type": "string",
        },
        "schema": {
          "description": "Schema name, e.g. "jaffle". Omit for the project's default schema.",
          "type": "string",
        },
        "table": {
          "description": "Unqualified table name, e.g. "raw_parts", not "jaffle.raw_parts"; pass the schema and database in their own parameters.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "table",
      ],
      "type": "object",
    },
    "name": "describeWarehouseTable",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "metadata": {
              "allOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "success",
                        "not_found",
                        "error",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "status",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "success",
                        "not_found",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "status",
                  ],
                  "type": "object",
                },
              ],
            },
            "result": {
              "type": "string",
            },
            "structuredContent": {
              "additionalProperties": false,
              "properties": {
                "columnCount": {
                  "description": "Number of columns returned.",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer",
                },
                "columns": {
                  "description": "Column names and warehouse types; empty when the table was not found or has no cached metadata.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                      },
                      "type": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "name",
                      "type",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "qualifiedName": {
                  "description": "Table name as resolved in the warehouse, e.g. "database.schema.table"; the schema part is "(default schema)" when none was given or resolved.",
                  "type": "string",
                },
              },
              "required": [
                "qualifiedName",
                "columnCount",
                "columns",
              ],
              "type": "object",
            },
          },
          "required": [
            "result",
            "metadata",
            "structuredContent",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "properties": {
            "metadata": {
              "allOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "success",
                        "not_found",
                        "error",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "status",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "refusal": {
                      "additionalProperties": false,
                      "properties": {
                        "action": {
                          "anyOf": [
                            {
                              "type": "string",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "capability": {
                          "anyOf": [
                            {
                              "type": "string",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "code": {
                          "const": "ai_access_refused",
                          "type": "string",
                        },
                        "connectUrl": {
                          "anyOf": [
                            {
                              "type": "string",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "message": {
                          "type": "string",
