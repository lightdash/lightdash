              "additionalProperties": false,
              "properties": {
                "exploreSearchResults": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "joinedTables": {
                        "anyOf": [
                          {
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                      "label": {
                        "type": "string",
                      },
                      "name": {
                        "type": "string",
                      },
                      "requiredFilters": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "fieldId": {
                              "type": "string",
                            },
                            "fieldRef": {
                              "type": "string",
                            },
                            "operator": {
                              "type": "string",
                            },
                            "required": {
                              "type": "boolean",
                            },
                            "settings": {},
                            "tableName": {
                              "type": "string",
                            },
                            "values": {
                              "items": {},
                              "type": "array",
                            },
                          },
                          "required": [
                            "fieldId",
                            "fieldRef",
                            "tableName",
                            "operator",
                            "required",
                          ],
                          "type": "object",
                        },
                        "type": "array",
                      },
                      "searchRank": {
                        "anyOf": [
                          {
                            "type": "number",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                    },
                    "required": [
                      "name",
                      "label",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "searchQuery": {
                  "type": "string",
                },
                "topMatchingFields": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "chartUsage": {
                        "anyOf": [
                          {
                            "type": "number",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                      "fieldType": {
                        "type": "string",
                      },
                      "label": {
                        "type": "string",
                      },
                      "name": {
                        "type": "string",
                      },
                      "searchRank": {
                        "anyOf": [
                          {
                            "type": "number",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                      "tableName": {
                        "type": "string",
                      },
                      "verifiedChartUsage": {
                        "anyOf": [
                          {
                            "type": "number",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                    },
                    "required": [
                      "name",
                      "label",
                      "tableName",
                      "fieldType",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
              },
              "required": [
                "searchQuery",
              ],
              "type": "object",
            },
            "status": {
              "enum": [
                "success",
                "error",
              ],
              "type": "string",
            },
          },
          "required": [
