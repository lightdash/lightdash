                      "enum": [
                        "success",
                        "error",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "status",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "success",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "status",
                  ],
                  "type": "object",
                },
              ],
            },
            "result": {
              "type": "string",
            },
            "structuredContent": {
              "additionalProperties": false,
              "properties": {
                "charts": {
                  "description": "Saved charts that directly reference the field.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "dashboardName": {
                        "anyOf": [
                          {
                            "type": "string",
                          },
                          {
                            "type": "null",
                          },
                        ],
                        "description": "Set when the chart lives inside a dashboard rather than a space.",
                      },
                      "name": {
                        "type": "string",
                      },
                      "spaceName": {
                        "type": "string",
                      },
                      "uuid": {
                        "type": "string",
                      },
                      "viewsCount": {
                        "type": "number",
                      },
                    },
                    "required": [
                      "uuid",
                      "name",
                      "spaceName",
                      "dashboardName",
                      "viewsCount",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "dashboardFilterTargets": {
                  "description": "Dashboards whose filters target the field.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                      },
                      "uuid": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "uuid",
                      "name",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "dashboards": {
                  "description": "Dashboards that embed an impacted chart.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                      },
                      "uuid": {
                        "type": "string",
                      },
                      "viaChartName": {
                        "description": "Name of an impacted chart that places this dashboard in the blast radius.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "uuid",
                      "name",
                      "viaChartName",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "fieldId": {
                  "description": "The analyzed field id ("<table>_<fieldName>").",
                  "type": "string",
                },
                "fieldType": {
                  "anyOf": [
                    {
                      "enum": [
                        "dimension",
                        "metric",
                      ],
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                  "description": "Inferred from the content referencing the field; null when nothing references it.",
                },
                "metricTreeDependents": {
                  "description": "Metrics built on this metric; they break with no chart between them.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "fieldId": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "fieldId",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "scheduledDeliveries": {
                  "description": "Scheduled deliveries and alerts on the affected charts or dashboards.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "dashboardUuid": {
                        "anyOf": [
                          {
                            "type": "string",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                      "name": {
                        "type": "string",
                      },
                      "savedChartUuid": {
                        "anyOf": [
                          {
                            "type": "string",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                    },
                    "required": [
                      "name",
                      "savedChartUuid",
                      "dashboardUuid",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "severity": {
                  "description": ""breaking" when at least one chart, dependent metric or dashboard filter references the field; otherwise "safe". Does not detect silent value-drift.",
                  "enum": [
                    "breaking",
                    "safe",
                  ],
                  "type": "string",
                },
                "summary": {
                  "additionalProperties": false,
                  "description": "Count of each referencing item type.",
                  "properties": {
                    "charts": {
                      "type": "number",
                    },
                    "dashboardFilterTargets": {
                      "type": "number",
                    },
                    "dashboards": {
                      "type": "number",
                    },
                    "metricTreeDependents": {
                      "type": "number",
                    },
                    "scheduledDeliveries": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "charts",
                    "dashboards",
                    "dashboardFilterTargets",
                    "metricTreeDependents",
                    "scheduledDeliveries",
                  ],
                  "type": "object",
                },
              },
              "required": [
                "fieldId",
                "fieldType",
                "severity",
                "summary",
                "charts",
                "dashboards",
                "dashboardFilterTargets",
                "metricTreeDependents",
                "scheduledDeliveries",
              ],
              "type": "object",
            },
          },
          "required": [
            "result",
            "metadata",
            "structuredContent",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "properties": {
            "metadata": {
