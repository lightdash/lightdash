              "additionalProperties": false,
              "properties": {
                "columns": {
                  "description": "Ordered list of column names matching the keys in each row of \`rows\`.",
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                "executionStats": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "description": "The warehouse's own report for the query job, as stated in the result.",
                      "properties": {
                        "bytesBilled": {
                          "anyOf": [
                            {
                              "type": "number",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "bytesProcessed": {
                          "anyOf": [
                            {
                              "type": "number",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "cacheHit": {
                          "anyOf": [
                            {
                              "type": "boolean",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "executionTimeMs": {
                          "anyOf": [
                            {
                              "type": "number",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "jobId": {
                          "anyOf": [
                            {
                              "type": "string",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                      },
                      "required": [
                        "jobId",
                        "bytesProcessed",
                        "bytesBilled",
                        "executionTimeMs",
                        "cacheHit",
                      ],
                      "type": "object",
                    },
                    {
                      "type": "null",
                    },
                  ],
                  "description": "Warehouse execution stats, when the warehouse reported them; null when it did not or the results came from the results cache.",
                },
                "review": {
                  "anyOf": [
                    {
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "rowCount": {
                  "description": "Total number of rows returned. May be less than the requested limit.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "rows": {
                  "anyOf": [
                    {
                      "description": "Result rows. Each row is an object keyed by column name. Values come from the warehouse as JSON-serializable primitives (numbers, strings, booleans, ISO date strings, or null).",
                      "items": {
                        "additionalProperties": {},
                        "propertyNames": {
                          "type": "string",
                        },
                        "type": "object",
                      },
                      "type": "array",
                    },
                    {
                      "type": "null",
                    },
                  ],
                  "description": "Raw values of the preview rows rendered as CSV in the result (first 50 at most); [] when the query returned no rows. Null when data access is disabled and the rows were withheld.",
                },
                "truncated": {
                  "description": "True when \`rows\` holds only the first rows of a larger result; \`rowCount\` is the full count.",
                  "type": "boolean",
                },
              },
              "required": [
                "rowCount",
                "columns",
                "rows",
                "truncated",
                "review",
              ],
              "type": "object",
            },
          },
          "required": [
            "result",
            "metadata",
            "structuredContent",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "properties": {
            "metadata": {
              "allOf": [
                {
