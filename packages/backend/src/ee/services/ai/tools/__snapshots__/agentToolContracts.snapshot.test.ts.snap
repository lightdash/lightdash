  {
    "description": "Start a background build of a new data app (an interactive app, a slide show or a PDF report) from a brief.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "chartSlugs": {
          "default": null,
          "description": "Saved charts whose queries the app builds on: slugs from findContent (find_content over MCP). The charts stay unchanged.",
          "items": {
            "type": "string",
          },
          "type": [
            "array",
            "null",
          ],
        },
        "dashboardSlug": {
          "default": null,
          "description": "Existing dashboard to start from: its slug, from findContent (find_content over MCP). The app starts from the dashboard's layout and charts; the dashboard stays unchanged.",
          "type": [
            "string",
            "null",
          ],
        },
        "externalConnectionSlugs": {
          "default": null,
          "description": "External connections to link to the app before the build: slugs from listDataAppConnections (list_data_app_connections over MCP). A data app calls an outside API only through a linked connection; naming one in the brief does not link it. Omit when the app uses no outside API.",
          "items": {
            "type": "string",
          },
          "type": [
            "array",
            "null",
          ],
        },
        "name": {
          "description": "Display name: a headline-short title in title case naming what the app shows ("Revenue Overview"). It also sets the app's permanent slug, so pick the final name now.",
          "type": "string",
        },
        "prompt": {
          "description": "Self-contained brief for the coding agent: what the app shows, for whom, and how it behaves. The coding agent explores the semantic layer itself but sees neither this conversation nor its query results. When this conversation already settled the analysis, carry each visualization over as a one-line description and a metric query line \`[viz title][explore; metrics; dimensions; filters; sort]\`, never as numbers: a number in the brief is hardcoded into the app, while a query stays live.",
          "type": "string",
        },
        "template": {
          "default": null,
          "description": "Starter template: "dashboard" for a dashboard-style app, "slideshow" for a slide show, "pdf" for a PDF report. Omit it, or pass "custom", for anything else.",
          "enum": [
            "dashboard",
            "slideshow",
            "pdf",
            "custom",
            null,
          ],
          "type": [
            "string",
            "null",
          ],
        },
        "themeSlug": {
          "default": null,
          "description": "Organization theme slug: the one the attached context lists ("Theme: <name> (slug: <slug>)"), which beats a theme named in the message, or else, when the user names a theme, brand or look, one from listDataAppThemes (list_data_app_themes over MCP). The coding agent receives the theme's files directly, so set the look here, not in the brief. Omit it for the organization default.",
          "type": [
            "string",
            "null",
          ],
        },
      },
      "required": [
        "name",
        "prompt",
      ],
      "type": "object",
    },
