            "metrics",
            "sorts",
            "tableCalculations",
          ],
          "type": "object",
        },
        "__schema35": {
          "additionalProperties": {},
          "description": "SQL chart config: { metadata: { version: 1 }, type, fieldConfig, display } for charts, or { metadata, type: "table", columns, display } for tables. See sql-chart-reference.",
