        "__schema130": {
          "additionalProperties": false,
          "properties": {
            "additionalSources": {
              "description": "The additional query to merge with queryConfig. Merge queries currently support exactly two sources.",
              "items": {
                "$ref": "#/definitions/__schema131",
              },
              "maxItems": 1,
              "minItems": 1,
              "type": "array",
            },
            "joinKey": {
              "items": {
                "$ref": "#/definitions/__schema133",
              },
              "minItems": 1,
