  {
    "description": "Create a scheduled delivery that sends a saved chart or dashboard to Slack channels or email recipients on a cron schedule. An enabled delivery sends from the moment it is created, so first propose the full configuration to the user (name, schedule in plain words, cron, timezone, destinations, format, AI augmentation prompt if any) and wait for their explicit confirmation in the conversation. Content that exists only in this conversation is saved with createContent first, then scheduled by the created uuid: propose the save and the schedule as one plan with a single confirmation.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "definitions": {
        "__schema1": {
          "additionalProperties": false,
          "properties": {
            "formatted": {
              "description": "Apply Lightdash value formatting.",
              "type": "boolean",
            },
            "limit": {
              "anyOf": [
                {
                  "const": "table",
                  "type": "string",
                },
                {
                  "const": "all",
                  "type": "string",
                },
                {
                  "exclusiveMinimum": 0,
                  "type": "integer",
                },
              ],
              "description": ""table" = the chart's own limit, "all" = all results, or an explicit row count.",
            },
          },
          "required": [
            "formatted",
            "limit",
          ],
          "type": "object",
        },
        "__schema6": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "channel": {
                  "description": "Slack channel ID (preferred, e.g. "C0123ABCDEF") or channel name. The Lightdash Slack app must be able to join it.",
                  "minLength": 1,
                  "type": "string",
                },
                "type": {
                  "const": "slack",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "channel",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "recipient": {
                  "description": "Email address of the recipient.",
                  "minLength": 3,
                  "type": "string",
                },
                "type": {
                  "const": "email",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "recipient",
              ],
              "type": "object",
            },
          ],
        },
      },
      "properties": {
        "aiAugmentationPrompt": {
          "description": "Instructions for the AI-written delivery message, regenerated from the delivered data on every send. null = plain delivery without AI augmentation.",
          "type": [
            "string",
            "null",
          ],
        },
        "cron": {
          "description": "5-part cron expression, e.g. "0 9 * * 1". Minimum frequency is hourly — sub-hourly minute patterns (e.g. "*/15") are rejected.",
          "type": "string",
        },
        "csvOptions": {
          "anyOf": [
            {
              "$ref": "#/definitions/__schema1",
            },
            {
              "type": "null",
            },
          ],
          "description": "Only used when format is "csv". null = defaults (formatted, table limit).",
        },
        "enabled": {
          "description": "true only when the user confirmed the delivery should go live; otherwise false creates it paused, for the user to enable from its page.",
          "type": "boolean",
        },
        "format": {
          "description": ""image" sends a rendered image of the chart/dashboard; "csv" sends the results as CSV.",
          "enum": [
            "csv",
            "image",
          ],
          "type": "string",
        },
        "message": {
          "description": "Optional static message included with every delivery. Ignored when aiAugmentationPrompt is set (the AI writes the message instead).",
          "type": [
            "string",
            "null",
          ],
        },
        "name": {
          "description": "Human-readable delivery name.",
          "minLength": 1,
          "type": "string",
        },
        "resourceType": {
          "description": "Type of saved content to deliver.",
          "enum": [
            "chart",
            "dashboard",
          ],
          "type": "string",
        },
        "resourceUuidOrSlug": {
          "description": "UUID (preferred) or project-scoped slug of the saved chart or dashboard to deliver. Use the uuid from the tool result that created or found the content as the canonical identity.",
          "type": "string",
        },
        "targets": {
          "description": "At least one Slack channel or email recipient.",
          "items": {
            "$ref": "#/definitions/__schema6",
          },
          "minItems": 1,
          "type": "array",
        },
        "timezone": {
          "description": "IANA timezone the cron runs in (e.g. "Europe/London"). null = project default.",
          "type": [
            "string",
            "null",
          ],
        },
      },
      "required": [
        "resourceType",
        "resourceUuidOrSlug",
        "name",
        "cron",
        "timezone",
        "format",
        "csvOptions",
        "message",
        "targets",
        "enabled",
        "aiAugmentationPrompt",
      ],
      "type": "object",
    },
