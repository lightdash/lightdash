  {
    "description": "List the project's external connections a data app can link: admin-configured, credentialed proxies to outside APIs (product analytics, billing, CRM). Call it when the user wants a data app to use an outside API or names a connection; match the request to a connection by name, slug or origin and pass its slug in externalConnectionSlugs. When none matches, tell the user no such connection is available rather than starting a build that cannot reach it.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "appSlug": {
          "default": null,
          "description": "A data app's slug. Pass it to see which connections that app already links; omit to list connections only.",
          "minLength": 1,
          "type": [
            "string",
            "null",
          ],
        },
      },
      "type": "object",
    },
    "name": "listDataAppConnections",
