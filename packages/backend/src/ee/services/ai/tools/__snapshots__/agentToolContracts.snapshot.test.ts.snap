  {
    "description": "Start a background build that adds a version to an existing data app from a brief describing the change. While a version of the app is already building, this call and every retry fail until that build ends: tell the user to wait for it to finish.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "appSlug": {
          "description": "Slug of the app to change: from an earlier build result, findContent or readContent (find_content, read_content over MCP).",
          "type": "string",
        },
        "chartSlugs": {
          "default": null,
          "description": "Saved charts whose queries the change builds on: slugs from findContent (find_content over MCP). The charts stay unchanged.",
          "items": {
            "type": "string",
          },
          "type": [
            "array",
            "null",
          ],
        },
        "dashboardSlug": {
          "default": null,
          "description": "Existing dashboard to pull in: its slug, from findContent (find_content over MCP). The coding agent gets the dashboard's layout and charts; the dashboard stays unchanged.",
          "type": [
            "string",
            "null",
          ],
        },
        "externalConnectionSlugs": {
          "default": null,
          "description": "External connections to add to the app before the build: slugs from listDataAppConnections (list_data_app_connections over MCP). Connections the app already links stay. A data app calls an outside API only through a linked connection; naming one in the brief does not link it. Omit when the change needs no new outside API.",
          "items": {
            "type": "string",
          },
          "type": [
            "array",
            "null",
          ],
        },
        "prompt": {
          "description": "Self-contained brief of the change for the coding agent, which works from the app's current source. The coding agent explores the semantic layer itself but sees neither this conversation nor its query results. Describe what to change and the outcome to expect, leaving out what stays the same; for a failed build, name what went wrong. When this conversation already settled the analysis, carry each visualization over as a one-line description and a metric query line \`[viz title][explore; metrics; dimensions; filters; sort]\`, never as numbers: a number in the brief is hardcoded into the app, while a query stays live.",
          "type": "string",
        },
        "themeSlug": {
          "default": null,
          "description": "Organization theme slug: the one the attached context lists ("Theme: <name> (slug: <slug>)"), which beats a theme named in the message, or else, when the user names a theme, brand or look, one from listDataAppThemes (list_data_app_themes over MCP). The coding agent receives the theme's files directly, so set the look here, not in the brief. Passing it switches the app's theme, so pass it only when the user asks to switch the theme in this request; omit it to keep the current one.",
          "type": [
            "string",
            "null",
          ],
        },
      },
      "required": [
        "appSlug",
        "prompt",
      ],
      "type": "object",
    },
