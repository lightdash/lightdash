exports[`AI agent tool contracts > matches the filter-expression field-value contract snapshot 1`] = `
{
  "description": "Tool: searchFieldValues

Purpose:
Validate or disambiguate a candidate value for a specific dimension (e.g. a product name or status) before filtering on it. Returns up to 100 unique values matching the query.

Usage Tips:
- Search only when the value is uncertain: when the user or field metadata already gives the exact value, filter on it directly
- Omit filters when the search does not need additional filters
- Filter expressions use \`<fieldId> <operator>[=<value>...]\`. The input schema defines filter scope, nullability, and the dimension-only AND constraint; for supported operators, quoting, and examples, follow the Lightdash Agent system prompt.

Reading the result:
- The values describe observed data, not the permitted filter literals.
- When the intended category needs interpretation rather than a literal match, clarify it with the user before filtering.
",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "fieldId": {
        "description": "The ID of the field to search values for "fieldId" must come from the previously searched Fields; otherwise, it will throw an error",
        "type": "string",
      },
      "filters": {
        "default": null,
        "description": "When present, scopes the candidate-value search with one flat AND filter expression containing dimension fields only.",
        "maxLength": 16384,
        "minLength": 1,
        "type": [
          "string",
          "null",
        ],
      },
      "query": {
        "description": "Candidate text to match within field values, e.g. "complete" for a status. Without candidate text only curated field metadata values come back reliably, and an empty warehouse-backed search may be rejected, so never use it to enumerate a column.",
        "type": [
          "string",
          "null",
        ],
      },
      "table": {
        "description": "The table to search in.",
        "type": "string",
      },
    },
    "required": [
      "table",
      "fieldId",
      "query",
    ],
    "type": "object",
  },
  "name": "searchFieldValues",
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "additionalProperties": false,
        "properties": {
          "metadata": {
            "allOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "success",
                      "error",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "status",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "success",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "status",
                ],
                "type": "object",
              },
            ],
          },
          "result": {
            "type": "string",
          },
          "structuredContent": {
            "additionalProperties": false,
            "properties": {
              "matchingValue": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "type": "number",
                      },
                      {
                        "type": "boolean",
                      },
                    ],
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "The returned value that matches the requested query (exact hit or decision-resolved equivalent); null when none was asserted.",
              },
              "note": {
                "anyOf": [
                  {
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Guidance about the returned values, e.g. that they come from curated field metadata or that value suggestions are disabled for the field. Null when there is none.",
              },
              "results": {
                "description": "Unique field values matching the query, at most 100. Empty when nothing matched.",
                "items": {},
                "type": "array",
              },
            },
            "required": [
              "results",
              "note",
              "matchingValue",
            ],
            "type": "object",
          },
        },
        "required": [
          "result",
          "metadata",
          "structuredContent",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "metadata": {
            "allOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
