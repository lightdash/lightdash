            "unitOfTime",
          ],
          "type": "object",
        },
        "__schema96": {
          "description": "Current period unit, e.g. weeks for this week.",
          "enum": [
            "days",
            "weeks",
            "months",
            "quarters",
            "years",
          ],
          "type": "string",
        },
