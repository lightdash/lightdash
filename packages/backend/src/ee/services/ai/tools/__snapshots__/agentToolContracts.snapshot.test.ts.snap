                        "success",
                        "error",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "status",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "success",
                      ],
                      "type": "string",
                    },
                  },
