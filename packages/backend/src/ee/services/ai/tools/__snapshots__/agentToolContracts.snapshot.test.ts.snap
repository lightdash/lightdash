        "description": {
          "description": "A descriptive summary or explanation for the dashboard.",
          "type": "string",
        },
        "title": {
          "description": "A descriptive title for the dashboard",
          "type": "string",
        },
        "visualizations": {
          "description": "Visualizations in generateVisualization's format, each serving the dashboard's theme.",
          "items": {
            "$ref": "#/definitions/__schema0",
          },
          "maxItems": 15,
          "minItems": 2,
          "type": "array",
        },
      },
      "required": [
        "title",
        "description",
        "visualizations",
      ],
      "type": "object",
    },
