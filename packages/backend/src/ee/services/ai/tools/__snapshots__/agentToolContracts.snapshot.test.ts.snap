                  "type": "string",
                },
              },
              "required": [
                "type",
                "chartSlug",
                "limit",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "chartSlug": {
                  "description": "Slug of the saved chart.",
                  "type": "string",
                },
                "dashboardSlug": {
                  "description": "Slug of the dashboard containing the chart.",
                  "type": "string",
                },
                "limit": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/__schema10",
                    },
                    {
                      "type": "null",
                    },
                  ],
                  "description": "Optional row limit override.",
                },
                "type": {
                  "const": "dashboardChart",
                  "type": "string",
                },
              },
              "required": [
