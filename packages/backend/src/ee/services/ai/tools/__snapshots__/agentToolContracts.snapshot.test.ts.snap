            },
            "joinType": {
              "enum": [
                "full",
                "left",
                "inner",
              ],
              "type": "string",
            },
            "primarySourceId": {
              "description": "Stable id assigned to the primary queryConfig.",
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "primarySourceId",
            "additionalSources",
            "joinKey",
            "joinType",
          ],
          "type": "object",
        },
        "__schema131": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string",
            },
            "queryConfig": {
              "additionalProperties": false,
              "description": "A second semantic-layer query. The primary query limit and parameter values apply to the whole merge.",
              "properties": {
                "customMetrics": {
                  "$ref": "#/definitions/__schema11",
                },
                "dimensions": {
                  "$ref": "#/definitions/__schema2",
                },
                "exploreName": {
                  "$ref": "#/definitions/__schema1",
                },
                "filters": {
                  "$ref": "#/definitions/__schema132",
                },
                "metrics": {
                  "$ref": "#/definitions/__schema4",
                },
                "sorts": {
                  "$ref": "#/definitions/__schema6",
                },
              },
              "required": [
                "exploreName",
                "dimensions",
