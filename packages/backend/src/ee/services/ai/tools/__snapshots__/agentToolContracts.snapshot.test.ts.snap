                          {
                            "type": "number",
                          },
                          {
                            "type": "null",
                          },
                        ],
                        "description": "The requested limit only when the summary states it; null when unstated or no limit was requested.",
                      },
                    },
                    "required": [
                      "requested",
                      "effective",
                      "max",
                    ],
                    "type": "object",
                  },
                  "outcome": {
                    "const": "results",
                    "description": "The query ran and returned rows, and they were recorded as a new version of the thread's chart artifact (the artifact is created on first use).",
                    "type": "string",
                  },
                  "parameters": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "description": "The parameter state the query ran with.",
                        "properties": {
                          "applied": {
                            "additionalProperties": {
                              "anyOf": [
                                {
                                  "type": "string",
                                },
                                {
                                  "type": "number",
                                },
                                {
                                  "items": {
