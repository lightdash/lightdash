                  "anyOf": [
                    {
                      "type": "number",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "prAction": {
                  "anyOf": [
                    {
                      "enum": [
                        "opened",
                        "updated",
                      ],
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "prUrl": {
                  "anyOf": [
                    {
                      "type": "string",
