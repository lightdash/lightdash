  {
    "description": "Run a pipeline: one or more nodes submitted together, where duckdb nodes join or transform other nodes' results. The terminal node's rows are returned to you.

Node kinds:
- "semanticLayer": a metric query against an explore. Result columns are the requested field ids.
- "sql": raw SQL against the project warehouse; may need user approval.
- "external": DuckDB SQL over uploaded or connected tables declared in "tables".
- "duckdb": DuckDB SQL over other results declared in "references".

A node reads only the rows its references returned, so a referenced result that reached its limit is incomplete: before totalling, averaging or ranking over it, give that node a limit that holds its whole population, or aggregate there.

Reuse across calls: a node id names one node for the whole thread. To build on a node from an earlier call, read its node id in "references" without resubmitting it; it is copied into this pipeline with everything it reads and served from cache when possible. Resubmitting a node id with a different definition is an error, so give a changed node a new node id.

Results stay hidden until you present one; each successful result says how.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "A one-line description of what the pipeline computes.",
        },
        "queries": {
          "description": "The nodes to submit, in any order: reads are resolved from duckdb references.",
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "One sentence on what this query does, only when the title is not enough. Null otherwise.",
                  },
                  "dimensions": {
                    "description": "Dimension field ids to group by, from the explore's schema.",
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "exploreName": {
                    "description": "The explore to run the metric query against.",
                    "type": "string",
                  },
                  "filters": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "dimensions": {
                            "anyOf": [
                              {
                                "maxLength": 16384,
                                "minLength": 1,
                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Flat filter expression for dimension fields.",
                          },
                          "metrics": {
                            "anyOf": [
                              {
                                "maxLength": 16384,
                                "minLength": 1,
                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Flat filter expression for metric fields.",
                          },
                        },
                        "required": [
                          "dimensions",
                          "metrics",
                        ],
                        "type": "object",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "Filters on this node's explore as flat expression strings, never structured rule objects: one for dimension fields and one for metric fields, each choosing AND or OR independently and combined with AND. Null when unfiltered, or null for an unused kind.",
                  },
                  "limit": {
                    "default": 500,
                    "description": "Maximum number of rows this node returns. Defaults to 500, max 500.",
                    "exclusiveMinimum": 0,
                    "maximum": 500,
                    "type": "integer",
                  },
                  "metrics": {
                    "description": "Metric field ids to compute, from the explore's schema.",
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "nodeId": {
                    "description": "Names this node so other nodes can read its result.",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$",
                    "type": "string",
                  },
                  "sorts": {
                    "anyOf": [
                      {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "descending": {
                              "description": "If true sorts in descending order, ascending otherwise.",
                              "type": "boolean",
                            },
                            "fieldId": {
                              "description": "Field id to sort by.",
                              "type": "string",
                            },
                          },
                          "required": [
                            "fieldId",
                            "descending",
                          ],
                          "type": "object",
                        },
                        "type": "array",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "Sorts by fields this node also selects in dimensions or metrics, e.g. [{"fieldId": "orders_order_date", "descending": true}].",
                  },
                  "sourceType": {
                    "const": "semanticLayer",
                    "type": "string",
                  },
                  "title": {
                    "description": "Short label a reader understands without seeing the query, two to five words, e.g. "Revenue by month". Shown to users instead of the node id.",
                    "type": "string",
                  },
                },
                "required": [
                  "sourceType",
                  "nodeId",
                  "title",
                  "description",
                  "exploreName",
                  "dimensions",
                  "metrics",
                  "filters",
                  "sorts",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "One sentence on what this query does, only when the title is not enough. Null otherwise.",
                  },
                  "limit": {
                    "default": 500,
                    "description": "Maximum number of rows this node returns. Defaults to 500, max 500.",
                    "exclusiveMinimum": 0,
                    "maximum": 500,
                    "type": "integer",
                  },
                  "nodeId": {
                    "description": "Names this node so other nodes can read its result.",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$",
                    "type": "string",
                  },
                  "sourceType": {
                    "const": "sql",
                    "type": "string",
                  },
                  "sql": {
                    "description": "A SELECT or WITH statement in the warehouse's SQL dialect.",
                    "type": "string",
                  },
                  "title": {
                    "description": "Short label a reader understands without seeing the query, two to five words, e.g. "Revenue by month". Shown to users instead of the node id.",
                    "type": "string",
                  },
                },
                "required": [
                  "sourceType",
                  "nodeId",
                  "title",
                  "description",
                  "sql",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "One sentence on what this query does, only when the title is not enough. Null otherwise.",
                  },
                  "limit": {
                    "default": 500,
                    "description": "Maximum number of rows this node returns. Defaults to 500, max 500.",
                    "exclusiveMinimum": 0,
                    "maximum": 500,
                    "type": "integer",
                  },
                  "nodeId": {
                    "description": "Names this node so other nodes can read its result.",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$",
                    "type": "string",
                  },
                  "references": {
                    "anyOf": [
                      {
                        "items": {
                          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$",
                          "type": "string",
                        },
                        "type": "array",
                      },
                      {
                        "additionalProperties": {
                          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$",
                          "type": "string",
                        },
                        "propertyNames": {
                          "type": "string",
                        },
                        "type": "object",
                      },
                    ],
                    "description": "Which nodes the SQL reads, by node id: an array (each exposed as a table named by its node id), or a map of {tableName: nodeId} to alias them.",
                  },
                  "sourceType": {
                    "const": "duckdb",
                    "type": "string",
                  },
                  "sql": {
                    "description": "DuckDB SQL over the tables "references" exposes.",
                    "type": "string",
                  },
                  "title": {
                    "description": "Short label a reader understands without seeing the query, two to five words, e.g. "Revenue by month". Shown to users instead of the node id.",
                    "type": "string",
                  },
                },
                "required": [
                  "sourceType",
                  "nodeId",
                  "title",
                  "description",
                  "sql",
                  "references",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "One sentence on what this query does, only when the title is not enough. Null otherwise.",
                  },
                  "limit": {
                    "default": 500,
                    "description": "Maximum number of rows this node returns. Defaults to 500, max 500.",
                    "exclusiveMinimum": 0,
                    "maximum": 500,
                    "type": "integer",
                  },
                  "nodeId": {
                    "description": "Names this node so other nodes can read its result.",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$",
                    "type": "string",
                  },
                  "sourceType": {
                    "const": "external",
                    "type": "string",
                  },
                  "sql": {
                    "description": "DuckDB SQL over the tables "tables" declares.",
                    "type": "string",
                  },
                  "tables": {
                    "anyOf": [
                      {
                        "items": {
                          "type": "string",
                        },
                        "type": "array",
                      },
                      {
                        "additionalProperties": {
                          "type": "string",
                        },
                        "propertyNames": {
                          "type": "string",
                        },
                        "type": "object",
                      },
                    ],
                    "description": "External tables this node reads: an array of table names (each exposed under its name), or a map of {sqlAlias: tableNameOrTableUuid}. Prefer table UUIDs from attached-source context so renames cannot break the query.",
                  },
                  "title": {
                    "description": "Short label a reader understands without seeing the query, two to five words, e.g. "Revenue by month". Shown to users instead of the node id.",
                    "type": "string",
                  },
                },
                "required": [
                  "sourceType",
                  "nodeId",
                  "title",
                  "description",
                  "sql",
                  "tables",
                ],
                "type": "object",
              },
            ],
          },
          "minItems": 1,
          "type": "array",
        },
        "terminalNodeId": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "The terminal node. Null picks the unique sink, the one submitted node no other submitted node reads; name a node when there are several sinks.",
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "A short title for the result, used when it is presented.",
        },
      },
      "required": [
        "title",
        "description",
        "queries",
        "terminalNodeId",
      ],
      "type": "object",
    },
    "name": "runComposerQueries",
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "metadata": {
              "allOf": [
                {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "description": {
                          "anyOf": [
                            {
                              "type": "string",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "queryUuid": {
                          "type": "string",
                        },
                        "status": {
                          "const": "success",
                          "type": "string",
                        },
                        "terminalNodeId": {
                          "description": "The node a presentation shows.",
                          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$",
                          "type": "string",
                        },
                        "title": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "status",
                        "queryUuid",
                        "terminalNodeId",
                        "title",
                        "description",
                      ],
                      "type": "object",
