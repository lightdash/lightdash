                                  },
                                  "type": "array",
                                },
                                {
                                  "items": {
                                    "type": "number",
                                  },
                                  "type": "array",
                                },
                              ],
                            },
                            "description": "Parameter values set explicitly in the tool call.",
                            "propertyNames": {
                              "type": "string",
                            },
                            "type": "object",
                          },
                          "defaulted": {
                            "additionalProperties": {
                              "anyOf": [
                                {
                                  "type": "string",
                                },
                                {
                                  "type": "number",
                                },
                                {
                                  "items": {
                                    "type": "string",
                                  },
                                  "type": "array",
                                },
                                {
                                  "items": {
                                    "type": "number",
                                  },
                                  "type": "array",
                                },
                              ],
                            },
                            "description": "Referenced parameters the tool call left unset, with the default value they resolved to.",
                            "propertyNames": {
                              "type": "string",
                            },
                            "type": "object",
                          },
                          "unset": {
                            "description": "Referenced parameters with neither a value in the tool call nor a default.",
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                        },
                        "required": [
                          "applied",
                          "defaulted",
                          "unset",
                        ],
                        "type": "object",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "null when the explore references no parameters or the query was a merge.",
                  },
                  "presentationNote": {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "The chart presentation note, verbatim; null when the result carries none.",
                  },
                  "queryUuid": {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "The uuid of this execution, when the run exposes it for citation; null otherwise.",
                  },
                  "review": {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "The reviewer prose carried by the result (query/question review, empty-result diagnosis, value hints), verbatim; null when the result carries none.",
                  },
                  "rowCount": {
                    "description": "Total rows the query returned.",
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "sourceCoverageNote": {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "The joined-measure source coverage note, verbatim; null when the result carries none.",
                  },
                  "truncationNote": {
                    "anyOf": [
                      {
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "The note stating that only part of the rows were written into the conversation, verbatim; null when every row is shown.",
                  },
                },
                "required": [
                  "outcome",
                  "queryUuid",
                  "chartVersionUuid",
                  "chartExport",
                  "truncationNote",
                  "review",
                  "presentationNote",
                  "chartQualityNote",
                  "sourceCoverageNote",
                  "rowCount",
                  "limit",
                  "parameters",
                  "data",
                ],
                "type": "object",
              },
            ],
          },
        },
        "required": [
          "result",
          "metadata",
          "structuredContent",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "metadata": {
            "allOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "chartImageUrl": {
                    "anyOf": [
                      {
                        "type": "string",
