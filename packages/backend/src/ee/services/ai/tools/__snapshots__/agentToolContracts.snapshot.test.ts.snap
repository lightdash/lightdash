                "success",
                "error",
              ],
              "type": "string",
            },
          },
          "required": [
            "status",
          ],
          "type": "object",
        },
        "result": {
          "type": "string",
        },
      },
      "required": [
        "result",
        "metadata",
      ],
      "type": "object",
    },
