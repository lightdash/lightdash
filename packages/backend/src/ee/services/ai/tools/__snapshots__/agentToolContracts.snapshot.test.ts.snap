        "schema": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema0",
            },
          ],
          "description": "Optional schema name to filter results.",
        },
        "search": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema1",
            },
          ],
          "description": "Optional case-insensitive substring filter on table name.",
        },
      },
      "type": "object",
    },
