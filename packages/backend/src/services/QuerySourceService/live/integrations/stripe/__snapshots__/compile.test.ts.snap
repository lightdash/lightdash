exports[`compile Stripe queries > compiles gross volume by month and currency, reading the last 90 days by default 1`] = `
"SELECT "stripe_charges_month" AS c0, "stripe_charges_currency" AS c1, "stripe_charges_amount" AS c2
FROM (
SELECT
  CAST(date_trunc('month', "stripe_charges".created) AS DATE) AS "stripe_charges_month",
  "stripe_charges"."currency" AS "stripe_charges_currency",
  SUM(CAST("stripe_charges".amount AS DOUBLE) / CASE WHEN lower("stripe_charges".currency) IN ('bif', 'clp', 'djf', 'gnf', 'jpy', 'kmf', 'krw', 'mga', 'pyg', 'rwf', 'ugx', 'vnd', 'vuv', 'xaf', 'xof', 'xpf') THEN 1 WHEN lower("stripe_charges".currency) IN ('bhd', 'jod', 'kwd', 'omr', 'tnd') THEN 1000 ELSE 100 END) AS "stripe_charges_amount"
FROM "charges" AS "stripe_charges"

WHERE ((
  ((CAST("stripe_charges".created AS DATE)) >= CAST('2026-08-27' AS timestamp) AND (CAST("stripe_charges".created AS DATE)) <= CAST('2026-11-25' AS timestamp))
) AND ((
  ("stripe_charges"."status") IN ('succeeded')
)))
GROUP BY 1,2
) AS live_query
ORDER BY c0 ASC"
`;
