{
    "name": "e2e",
    "version": "1.38.2",
    "private": true,
    "license": "MIT",
    "main": "index.js",
    "scripts": {
        "playwright:open": "TZ=${TZ:-UTC} playwright test --ui",
        "playwright:run": "TZ=${TZ:-UTC} playwright test",
        "playwright:list": "TZ=${TZ:-UTC} playwright test --list",
        "playwright:report": "playwright show-report",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "linter": "oxlint -c .oxlintrc.json --ignore-path ./../../.gitignore",
        "formatter": "oxfmt",
        "lint": "pnpm run linter ./playwright ./playwright.config.ts",
        "fix-lint": "pnpm run linter ./playwright ./playwright.config.ts --fix",
        "format": "oxfmt ./playwright ./playwright.config.ts ./tsconfig.json --check",
        "fix-format": "oxfmt ./playwright ./playwright.config.ts ./tsconfig.json"
    },
    "dependencies": {
        "@lightdash/common": "workspace:*"
    },
    "devDependencies": {
        "@playwright/test": "1.56.1",
        "oxlint": "1.75.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    }
}
