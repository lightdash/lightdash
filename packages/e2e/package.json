{
    "name": "e2e",
    "version": "3.108.4",
    "private": true,
    "license": "MIT",
    "scripts": {
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "test:app": "playwright test tests/app",
        "test:api": "playwright test tests/api",
        "test:cli": "playwright test tests/cli",
        "typecheck": "tsc --noEmit",
        "linter": "oxlint -c .oxlintrc.json --ignore-path ./../../.gitignore",
        "formatter": "oxfmt",
        "lint": "pnpm run linter ./tests ./support ./playwright.config.ts",
        "fix-lint": "pnpm run linter ./tests ./support ./playwright.config.ts --fix",
        "format": "oxfmt ./tests ./support ./playwright.config.ts --check",
        "fix-format": "oxfmt ./tests ./support ./playwright.config.ts"
    },
    "dependencies": {
        "@lightdash/common": "workspace:*",
        "@playwright/test": "1.63.0",
        "dayjs": "1.11.10",
        "js-yaml": "4.3.2"
    },
    "devDependencies": {
        "@types/js-yaml": "4.0.9",
        "@types/node": "24.10.1",
        "oxlint": "1.75.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    }
}
