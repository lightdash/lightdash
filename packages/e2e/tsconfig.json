{
    "extends": "./../../tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "dom"],
        "types": ["node"],
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "isolatedModules": true
    },
    "include": ["playwright.config.ts", "playwright/**/*.ts"],
    "exclude": []
}
