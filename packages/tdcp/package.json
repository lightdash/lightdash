{
    "name": "@lightdash/tdcp",
    "version": "0.0.1",
    "private": true,
    "license": "MIT",
    "description": "Tabular Data Context Protocol (draft): spec, JSON schemas, and the server/client TypeScript SDK. Deliberately dependency-free so it can move to a standalone repo unchanged.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc --build",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "format": "oxfmt ./src ./tests ./examples --check",
        "fix-format": "oxfmt ./src ./tests ./examples",
        "lint": "pnpm run linter ./src ./tests ./examples",
        "fix-lint": "pnpm run linter ./src ./tests ./examples --fix",
        "linter": "oxlint -c .oxlintrc.json --ignore-path ./../../.gitignore",
        "test": "vitest run"
    },
    "devDependencies": {
        "oxlint": "1.57.0",
        "oxlint-tsgolint": "0.18.1",
        "typescript": "7.0.2",
        "vitest": "4.1.6"
    }
}
