// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`preserves ordinary launch statements in the refused command handlers/apps/createApp.ts 1`] = `
[
  "execa('npm', ['--version'])",
  "execa(
        'npm',
        ['install', '--include=dev', '--ignore-scripts', '--no-package-lock'],
        subprocessOptions,
    )",
  "execa(
        'npx',
        ['--yes', \`shadcn@\${SHADCN_VERSION}\`, 'init', '--defaults', '--force'],
        shadcnOptions,
    )",
  "execa(
        'npx',
        [
            '--yes',
            \`shadcn@\${SHADCN_VERSION}\`,
            'add',
            '--overwrite',
            '--yes',
            ...SHADCN_COMPONENTS,
        ],
        shadcnOptions,
    )",
]
`;

exports[`preserves ordinary launch statements in the refused command handlers/apps/preview.ts 1`] = `
[
  "execa(
        'npm',
        ['install', '--include=dev', '--ignore-scripts', '--no-package-lock'],
        {
            cwd: args.appDir,
            env: {
                ...process.env,
                npm_config_ignore_scripts: 'true',
                npm_config_package_lock: 'false',
            },
            stdio: 'inherit',
        },
    )",
  "execa(
            'npm',
            [
                'run',
                'dev',
                ...(devServerPort !== undefined
                    ? ['--', '--port', String(devServerPort), '--strictPort']
                    : []),
            ],
            {
                cwd: target.appDir,
                stdio: 'inherit',
                extendEnv: false,
                env: buildPreviewChildEnv({
                    serverUrl,
                    projectUuid: target.projectUuid,
                    proxyPort: proxy.port,
                    proxyNonce,
                    browserImageOrigins,
                }),
            },
        )",
]
`;

exports[`preserves ordinary launch statements in the refused command handlers/diagnostics.ts 1`] = `
[
  "execa('dbt', args, {
            all: true,
            stdio: ['pipe', 'pipe', 'pipe'],
        })",
]
`;
