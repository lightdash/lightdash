            ],
            {
                cwd: target.appDir,
                stdio: 'inherit',
                extendEnv: false,
                env: buildPreviewChildEnv({
                    serverUrl,
                    projectUuid: target.projectUuid,
                    proxyPort: proxy.port,
                    proxyNonce,
                    browserImageOrigins,
                }),
            },
        )",
]
`;

