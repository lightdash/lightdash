exports[`preserves ordinary launch statements in the refused command handlers/apps/preview.ts 1`] = `
[
  "execa(
        'npm',
        ['install', '--include=dev', '--ignore-scripts', '--no-package-lock'],
        {
            cwd: args.appDir,
            env: {
                ...process.env,
                npm_config_ignore_scripts: 'true',
                npm_config_package_lock: 'false',
            },
            stdio: 'inherit',
        },
    )",
  "execa(
            'npm',
            [
                'run',
                'dev',
                ...(devServerPort !== undefined
