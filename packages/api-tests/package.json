{
    "name": "api-tests",
    "version": "0.2544.1",
    "private": true,
    "license": "MIT",
    "scripts": {
        "linter": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint oxlint -c .oxlintrc.json --ignore-path ./../../.gitignore",
        "formatter": "oxfmt",
        "lint": "pnpm run linter .",
        "fix-lint": "pnpm run linter . --fix",
        "format": "oxfmt . --check",
        "fix-format": "oxfmt .",
        "typecheck": "tsrs --project tsconfig.json --noEmit",
        "stub:snowflake-ai": "node stub/snowflake-ai-stub.mjs",
        "test:api": "vitest run --config vitest.config.ts",
        "test:unit": "vitest run --config vitest.unit.config.ts",
        "test:api:watch": "vitest watch --config vitest.config.ts"
    },
    "dependencies": {
        "@lightdash/common": "workspace:*",
        "js-yaml": "4.3.2"
    },
    "devDependencies": {
        "@types/js-yaml": "4.0.9",
        "@types/pg": "8.11.10",
        "oxlint": "1.75.0",
        "pg": "8.13.1",
        "tsrs": "0.21.0-ts7.1.0-beta",
        "typescript": "7.0.2",
        "vitest": "4.1.11"
    }
}
