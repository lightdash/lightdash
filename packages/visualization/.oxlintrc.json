{
    "$schema": "../../node_modules/oxlint/configuration_schema.json",
    "extends": ["../../.oxlintrc.base.json"],
    "options": {
        "typeAware": true
    },
    "rules": {
        "@typescript-eslint/consistent-type-imports": [
            "error",
            { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
        ],
        "@typescript-eslint/only-throw-error": "warn",
        "no-unused-vars": [
            "error",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_",
                "ignoreRestSiblings": true,
                "caughtErrors": "none"
            }
        ],
        "no-case-declarations": "off",
        "no-template-curly-in-string": "off",
        /* The chart builders moved here from the frontend, which runs the
           rules below off. They stay off so the code keeps matching the
           frontend's tests line for line; tighten them as files are rewritten. */
        "@typescript-eslint/no-explicit-any": "off",
        "prefer-destructuring": "off",
        "no-nested-ternary": "off",
        "no-restricted-globals": "off",
        "radix": "off",
        "arrow-body-style": "off",
        "prefer-object-spread": "off",
        "prefer-const": "off",
        "no-else-return": "off",
        "no-plusplus": "off",
        "no-continue": "off",
        "no-console": "off"
    },
    "overrides": [
        {
            "files": ["**/*.mock.ts", "**/*.test.ts", "**/*.spec.ts"],
            "rules": {
                "@typescript-eslint/no-unsafe-member-access": "off",
                "@typescript-eslint/no-unsafe-assignment": "off",
                "@typescript-eslint/no-unsafe-call": "off"
            }
        }
    ]
}
