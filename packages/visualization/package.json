{
    "name": "@lightdash/visualization",
    "version": "2.389.1",
    "description": "Headless Lightdash chart engine: turns a saved chart's config and query results into ECharts options, table and big number models",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/lightdash/lightdash.git"
    },
    "files": [
        "dist/**/*"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "module": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js",
            "import": "./dist/esm/index.js",
            "default": "./dist/cjs/index.js"
        },
        "./editor": {
            "types": "./dist/esm/editor.d.ts",
            "module": "./dist/esm/editor.js",
            "require": "./dist/cjs/editor.js",
            "import": "./dist/esm/editor.js",
            "default": "./dist/cjs/editor.js"
        },
        "./src": "./src/index.ts",
        "./src/*": [
            "./src/*.ts",
            "./src/*"
        ],
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "tsc --build --watch --preserveWatchOutput ./tsconfig.build.json",
        "build": "tsc --build ./tsconfig.build.json",
        "postbuild": "node ./scripts/markEsmOutput.mjs",
        "typecheck": "tsc --project tsconfig.json --noEmit --composite false",
        "linter": "oxlint -c .oxlintrc.json --ignore-path ./../../.gitignore",
        "formatter": "oxfmt",
        "lint": "pnpm run linter ./src",
        "fix-lint": "pnpm run linter ./src --fix",
        "format": "oxfmt ./src ./browser/specs ./browser/harness.ts ./browser/vite.config.ts ./browser/playwright.config.ts --check",
        "fix-format": "oxfmt ./src ./browser/specs ./browser/harness.ts ./browser/vite.config.ts ./browser/playwright.config.ts",
        "test": "vitest run --config vitest.config.ts",
        "test:dev": "vitest watch --config vitest.config.ts --changed",
        "test:browser": "playwright test --config browser/playwright.config.ts",
        "release": "pnpm publish --no-git-checks --access public"
    },
    "dependencies": {
        "@lightdash/common": "workspace:*",
        "dayjs": "1.11.10",
        "echarts": "5.6.0",
        "lodash": "4.18.1",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@types/lodash": "4.14.202",
        "@types/node": "24.13.2",
        "oxlint": "1.75.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "vite": "8.0.16",
        "vitest": "4.1.11"
    }
}
