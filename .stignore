# Syncthing ignore file used by Okteto file sync (okteto.dev.yaml).
# Keep in sync with .gitignore; syncthing-only entries are grouped below.
# Pattern reference: https://docs.syncthing.net/users/ignoring.html

# version control
.git
.local/
.worktrees/

# not needed in the dev container (tracked in git, skipped from sync)
/.github
/.context
/docs
/static/screenshots
/CHANGELOG.md

# dependencies (bare pattern matches at any depth)
node_modules

# testing
coverage
/packages/e2e/cypress/screenshots
/packages/e2e/cypress/videos
/packages/e2e/cypress/downloads
/packages/e2e/cypress/artifacts
# Content as code e2e tests
packages/e2e/lightdash

# eval reports
/packages/backend/eval-reports

# logs (logs/ under "# dbt" below covers the per-package log dirs)
(?d)*.log

# development
lightdash_dev.yml

# build outputs (no tracked files live under dirs with these names)
dist
build
bundle
target

# CLI binaries
/packages/cli/bin/

# misc
(?d).DS_Store
.idea

# typescript
(?d)*.tsbuildinfo

# local dbt/profiles symlinks
/dbt
/profile*

# credentials
credentials.json

# dbt
dbt_packages
dbt_internal_packages
dbt_modules/
venv
.venv/
.venvs/
logs/

# direnv
/.envrc
.direnv/

# nix flakes
flake.nix
flake.lock


# Charts as code
/examples/full-jaffle-shop-demo/dbt/lightdash
/examples/lightdash
/lightdash
/packages/cli/lightdash/

# Prometheus
prometheus.yml
data/

# environment
.env*

CLAUDE.local.md
AGENTS.override.md
.playwright-mcp 

http-client.private.env.json

# turbo
(?d).turbo

# janix
.janix

# rodney
.rodney

# HAR replay
scripts/har-replay-server.ts
*.har
agent-harness/cloud/credentials.env

# AI
.agents
.codex
.claude/*.lock
AGENTS.md

# octarine
.octarine/properties.json

# editor swap files
*.swp

# Superpowers brainstorm scratch
.superpowers/

# Playground bundle builder venv
scripts/playground-bundle/.venv/

# Local pnpm store (also keeps it out of Okteto file sync via .stignore)
.pnpm-store/
