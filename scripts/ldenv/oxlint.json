{
    "plugins": ["typescript", "node", "promise"],
    "categories": { "correctness": "error" },
    "rules": {
        "eqeqeq": "error",
        "no-var": "error",
        "prefer-const": "error",
        "no-eval": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-floating-promises": "off"
    }
}
