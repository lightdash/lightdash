{
  "scenario": {
    "agent": "Emulated scenarios agent",
    "composerCharts": "default",
    "decision": null,
    "title": "Agent reads and renames a space-owned composer chart by its uuid",
    "covers": [
      "#33619",
      "#33622"
    ],
    "persona": "admin",
    "startFrom": "the agent's chat page",
    "prompt": "Rename the chart I linked to Payments by method (emulator).",
    "expect": [
      "readContent and editContent both accept the uuid as slug",
      "the rename saves without a new version; the slug stays emulator-space-payments",
      "the chip opens the renamed chart"
    ],
    "readBack": [
      "composer_charts.name changed, version count unchanged"
    ]
  },
  "strict": false,
  "timing": {
    "ttftMs": 250,
    "chunkDelayMs": 15
  },
  "rules": [
    {
      "id": "load-tools",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "tool": "loadAgentTools"
      },
      "times": 1,
      "reply": [
        {
          "type": "tool_call",
          "name": "loadAgentTools",
          "arguments": {}
        }
      ]
    },
    {
      "id": "read",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "tool": "readContent"
      },
      "times": 1,
      "reply": [
        {
          "type": "tool_call",
          "name": "readContent",
          "arguments": {
            "type": "composer_chart",
            "slug": "{{space_chart}}"
          }
        }
      ]
    },
    {
      "id": "edit",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "tool": "editContent"
      },
      "times": 1,
      "reply": [
        {
          "type": "tool_call",
          "name": "editContent",
          "arguments": {
            "type": "composer_chart",
            "slug": "{{space_chart}}",
            "patch": [
              {
                "op": "replace",
                "path": "/name",
                "value": "Payments by method (emulator)"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "answer",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "hasToolResult": true
      },
      "reply": [
        {
          "type": "text",
          "text": "Renamed. [Payments by method (emulator)](/projects/{{project}}/composer-charts/{{space_chart}})"
        }
      ]
    }
  ]
}
