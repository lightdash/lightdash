{
  "scenario": {
    "agent": "Emulated scenarios agent",
    "composerCharts": "default",
    "decision": "approved",
    "title": "Agent queries, then saves the query node into a space without a second approval",
    "covers": [
      "#33617"
    ],
    "persona": "admin",
    "startFrom": "the agent's chat page",
    "prompt": "Chart payments of at least 20 by method and save it in Emulator scenarios.",
    "expect": [
      "one approval card, for the query",
      "createContent from the node succeeds without another card",
      "the chip opens the saved chart"
    ],
    "readBack": [
      "composer_charts row named Emulator node payments in Emulator scenarios"
    ]
  },
  "strict": false,
  "timing": {
    "ttftMs": 250,
    "chunkDelayMs": 15
  },
  "rules": [
    {
      "id": "load-tools",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "tool": "loadAgentTools"
      },
      "times": 1,
      "reply": [
        {
          "type": "tool_call",
          "name": "loadAgentTools",
          "arguments": {}
        }
      ]
    },
    {
      "id": "query",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "tool": "query"
      },
      "times": 1,
      "reply": [
        {
          "type": "tool_call",
          "name": "query",
          "arguments": {
            "title": null,
            "description": "Payments by method",
            "terminalNodeId": null,
            "queries": [
              {
                "nodeId": "payments_by_method",
                "sourceType": "sql",
                "title": "Payments by method",
                "description": "Total payment amount per payment method.",
                "sql": "SELECT payment_method, SUM(amount) AS total_amount FROM postgres.jaffle.payments WHERE amount >= 20 GROUP BY 1",
                "limit": 500
              }
            ]
          }
        }
      ]
    },
    {
      "id": "create",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "tool": "createContent"
      },
      "times": 1,
      "reply": [
        {
          "type": "tool_call",
          "name": "createContent",
          "arguments": {
            "type": "composer_chart",
            "content": {
              "from": "node",
              "name": "Emulator node payments",
              "description": null,
              "spaceSlug": "emulator-scenarios",
              "dashboardSlug": null,
              "nodeId": "payments_by_method",
              "sessionId": null,
              "vizConfig": {
                "type": "bar",
                "x": "payment_method",
                "y": [
                  "total_amount"
                ],
                "groupBy": null,
                "stack": null,
                "horizontal": null,
                "y2": null,
                "labels": null
              }
            }
          }
        }
      ]
    },
    {
      "id": "answer",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "hasToolResult": true
      },
      "reply": [
        {
          "type": "text",
          "text": "Saved. [Emulator node payments](/projects/{{project}}/composer-charts/emulator-node-payments)"
        }
      ]
    }
  ]
}
