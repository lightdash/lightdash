{
  "scenario": {
    "agent": "Emulated scenarios agent",
    "composerCharts": "default",
    "decision": "approved",
    "title": "Twin: agent edits a dashboard-owned composer chart's SQL; the user approves",
    "covers": [
      "#33612 regression",
      "SQL approval"
    ],
    "persona": "admin",
    "startFrom": "the agent's chat page",
    "prompt": "Only count payments of at least 10 in the payments chart on the Emulator dashboard.",
    "expect": [
      "approval card before any write",
      "editContent saves a new version in place",
      "the chart stays owned by the dashboard; the tile shows the new totals"
    ],
    "readBack": [
      "composer_chart_versions: one more row",
      "dashboard tile still points at the chart"
    ]
  },
  "strict": false,
  "timing": {
    "ttftMs": 250,
    "chunkDelayMs": 15
  },
  "rules": [
    {
      "id": "load-tools",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "tool": "loadAgentTools"
      },
      "times": 1,
      "reply": [
        {
          "type": "tool_call",
          "name": "loadAgentTools",
          "arguments": {}
        }
      ]
    },
    {
      "id": "edit",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "tool": "editContent"
      },
      "times": 1,
      "reply": [
        {
          "type": "tool_call",
          "name": "editContent",
          "arguments": {
            "type": "composer_chart",
            "slug": "emulator-dashboard-payments",
            "patch": [
              {
                "op": "replace",
                "path": "/pipeline/nodes/0/sql",
                "value": "SELECT payment_method, SUM(amount) AS total_amount FROM postgres.jaffle.payments WHERE amount >= 10 GROUP BY 1"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "answer",
      "match": {
        "format": "openai-responses",
        "stream": true,
        "hasToolResult": true
      },
      "reply": [
        {
          "type": "text",
          "text": "Done. [Emulator dashboard](/projects/{{project}}/dashboards/{{dashboard}}/view)"
        }
      ]
    }
  ]
}
