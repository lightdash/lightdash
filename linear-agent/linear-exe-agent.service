[Unit]
Description=Lightdash Linear exe.dev agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/opt/linear-exe-agent
EnvironmentFile=/etc/linear-exe-agent.env
Environment=PATH=/exec-daemon:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/env node /opt/linear-exe-agent/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
