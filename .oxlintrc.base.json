{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "extends": ["oxlint:recommended"],
    "plugins": ["typescript", "import", "node", "promise", "vitest"],
    "jsPlugins": [
        { "name": "perfectionist", "specifier": "eslint-plugin-perfectionist" },
        { "name": "vitest-js", "specifier": "@vitest/eslint-plugin" }
    ],
    "rules": {
        /* ── eslint core (airbnb-base parity) ─────────────────────────── */
        "eqeqeq": ["error", "always", { "null": "ignore" }],
        "no-void": ["error", { "allowAsStatement": true }],
        "no-await-in-loop": "error",
        "no-param-reassign": [
            "error",
            {
                "props": true,
                "ignorePropertyModificationsFor": [
                    "acc",
                    "accumulator",
                    "e",
                    "ctx",
                    "context",
                    "req",
                    "request",
                    "res",
                    "response",
                    "$scope",
                    "staticContext"
                ]
            }
        ],
        "array-callback-return": "error",
        "arrow-body-style": [
            "error",
            "as-needed",
            { "requireReturnForObjectLiteral": false }
        ],
        "block-scoped-var": "error",
        "consistent-return": "error",
        "default-case": "error",
        "default-case-last": "error",
        "func-names": "warn",
        "global-require": "error",
        "grouped-accessor-pairs": "error",
        "guard-for-in": "error",
        "max-classes-per-file": ["error", 1],
        "new-cap": ["error", { "newIsCap": true, "capIsNew": false }],
        "no-alert": "error",
        "no-bitwise": "error",
        "no-caller": "error",
        "no-case-declarations": "error",
        "no-console": "warn",
        "no-constructor-return": "error",
        "no-continue": "error",
        "no-else-return": "error",
        "no-empty": "error",
        "no-empty-function": [
            "error",
            { "allow": ["arrowFunctions", "functions", "methods"] }
        ],
        "no-eval": "error",
        "no-extend-native": "error",
        "no-extra-bind": "error",
        "no-extra-label": "error",
        "no-fallthrough": "error",
        "no-inner-declarations": "error",
        "no-iterator": "error",
        "no-label-var": "error",
        "no-labels": "error",
        "no-lone-blocks": "error",
        "no-lonely-if": "error",
        "no-multi-assign": "error",
        "no-multi-str": "error",
        "no-nested-ternary": "error",
        "no-new": "error",
        "no-new-require": "error",
        "no-new-wrappers": "error",
        "no-path-concat": "error",
        "no-plusplus": "error",
        "no-promise-executor-return": "error",
        "no-proto": "error",
        "no-prototype-builtins": "error",
        "no-regex-spaces": "error",
        "no-restricted-globals": [
            "error",
            {
                "name": "isFinite",
                "message": "Use Number.isFinite instead"
            },
            { "name": "isNaN", "message": "Use Number.isNaN instead" },
            "addEventListener",
            "blur",
            "close",
            "closed",
            "confirm",
            "defaultStatus",
            "defaultstatus",
            "event",
            "external",
            "find",
            "focus",
            "frameElement",
            "frames",
            "history",
            "innerHeight",
            "innerWidth",
            "length",
            "location",
            "locationbar",
            "menubar",
            "moveBy",
            "moveTo",
            "name",
            "onblur",
            "onerror",
            "onfocus",
            "onload",
            "onresize",
            "onunload",
            "open",
            "opener",
            "opera",
            "outerHeight",
            "outerWidth",
            "pageXOffset",
            "pageYOffset",
            "parent",
            "print",
            "removeEventListener",
            "resizeBy",
            "resizeTo",
            "screen",
            "screenLeft",
            "screenTop",
            "screenX",
            "screenY",
            "scroll",
            "scrollbars",
            "scrollBy",
            "scrollTo",
            "scrollX",
            "scrollY",
            "self",
            "status",
            "statusbar",
            "stop",
            "toolbar",
            "top"
        ],
        "no-return-assign": "error",
        "no-script-url": "error",
        "no-self-compare": "error",
        "no-sequences": "error",
        "no-template-curly-in-string": "error",
        "no-unneeded-ternary": "error",
        "no-useless-computed-key": "error",
        "no-useless-concat": "error",
        "no-useless-rename": "error",
        /* oxlint lacks ESLint's in-try-block exception (FPs with a behavior-changing autofix) — re-enable when fixed upstream */
        "no-useless-return": "off",
        "no-var": "error",
        "operator-assignment": ["error", "always"],
        "prefer-const": "error",
        "prefer-destructuring": [
            "error",
            {
                "VariableDeclarator": { "array": false, "object": true },
                "AssignmentExpression": { "array": true, "object": false }
            },
            { "enforceForRenamedProperties": false }
        ],
        "prefer-exponentiation-operator": "error",
        "prefer-numeric-literals": "error",
        "prefer-object-spread": "error",
        "prefer-promise-reject-errors": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error",
        "prefer-template": "error",
        "radix": "error",
        "symbol-description": "error",
        "vars-on-top": "error",
        "yoda": "error",
        "no-unused-vars": [
            "error",
            {
                "vars": "all",
                "args": "after-used",
                "ignoreRestSiblings": true,
                "caughtErrors": "none"
            }
        ],
        /* oxlint misses `this` in parameter defaults — re-enable when fixed upstream */
        "class-methods-use-this": "off",
        /* rules from oxlint:recommended not in the previous ESLint setup — enable incrementally */
        "no-control-regex": "off",
        "no-unsafe-optional-chaining": "off",
        "no-unassigned-vars": "off",
        "no-constant-binary-expression": "off",
        "promise/no-callback-in-promise": "off",
        "unicorn/no-useless-spread": "off",
        "unicorn/no-useless-fallback-in-spread": "off",

        /* ── import ───────────────────────────────────────────────────── */
        "import/first": "error",
        "import/export": "error",
        "import/no-absolute-path": "error",
        "import/no-amd": "error",
        "import/no-cycle": "error",
        "import/no-duplicates": "error",
        "import/no-dynamic-require": "error",
        "import/no-mutable-exports": "error",
        "import/no-named-as-default": "off",
        "import/no-self-import": "error",
        "import/no-webpack-loader-syntax": "error",
        "import/prefer-default-export": "off",

        /* ── @typescript-eslint (syntax + tsgolint type-aware) ────────── */
        "@typescript-eslint/no-explicit-any": "error",
        "@typescript-eslint/no-floating-promises": [
            "error",
            { "ignoreVoid": true, "ignoreIIFE": true }
        ],
        "@typescript-eslint/dot-notation": "error",
        "@typescript-eslint/no-implied-eval": "error",
        "@typescript-eslint/return-await": ["error", "in-try-catch"],
        "@typescript-eslint/default-param-last": "error",
        "@typescript-eslint/no-array-constructor": "error",
        "@typescript-eslint/no-empty-function": [
            "error",
            {
                "allow": [
                    "arrowFunctions",
                    "functions",
                    "methods",
                    "constructors"
                ]
            }
        ],
        "@typescript-eslint/no-loop-func": "error",
        "@typescript-eslint/no-redeclare": "error",
        "@typescript-eslint/no-shadow": "error",
        "@typescript-eslint/no-unused-expressions": "error",
        "@typescript-eslint/no-use-before-define": "error",
        "@typescript-eslint/no-useless-constructor": "error",
        "@typescript-eslint/only-throw-error": "error",
        /* type-aware rules from oxlint:recommended not in the previous ESLint setup — enable incrementally */
        "@typescript-eslint/restrict-template-expressions": "off",
        "@typescript-eslint/no-base-to-string": "off",
        "@typescript-eslint/unbound-method": "off",
        "@typescript-eslint/triple-slash-reference": "off",
        "@typescript-eslint/no-non-null-asserted-optional-chain": "off",
        "@typescript-eslint/no-wrapper-object-types": "off",
        "@typescript-eslint/prefer-as-const": "off",
        "@typescript-eslint/await-thenable": "off",
        "@typescript-eslint/no-duplicate-type-constituents": "off",
        "@typescript-eslint/no-misused-spread": "off",
        "@typescript-eslint/no-redundant-type-constituents": "off",
        "@typescript-eslint/require-array-sort-compare": "off",

        /* ── perfectionist (via jsPlugin; oxfmt only sorts declarations) ─ */
        "perfectionist/sort-named-imports": [
            "error",
            {
                "type": "natural",
                "ignoreCase": true,
                "groups": ["value-import", "type-import"]
            }
        ]
    },
    "overrides": [
        {
            "files": [
                "**/*.mock.ts",
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/*.spec.ts",
                "**/*.spec.tsx"
            ],
            "rules": {
                "@typescript-eslint/dot-notation": [
                    "error",
                    {
                        "allowPrivateClassPropertyAccess": true,
                        "allowProtectedClassPropertyAccess": true
                    }
                ],
                "vitest/no-focused-tests": "error",
                "vitest/no-import-node-test": "error",
                "vitest-js/expect-expect": "off",
                "vitest-js/no-commented-out-tests": "warn",
                "vitest-js/no-conditional-expect": "off",
                "vitest-js/no-disabled-tests": "warn",
                "vitest-js/no-standalone-expect": "off",
                "vitest-js/no-identical-title": "error",
                "vitest-js/no-interpolation-in-snapshots": "error",
                "vitest-js/no-mocks-import": "error",
                "vitest-js/no-unneeded-async-expect-function": "error",
                "vitest-js/prefer-called-exactly-once-with": "error",
                "vitest-js/require-local-test-context-for-concurrent-snapshots": "error",
                "vitest-js/valid-describe-callback": "error",
                "vitest-js/valid-expect": "error",
                "vitest-js/valid-expect-in-promise": "error",
                "vitest-js/valid-title": ["error", { "allowArguments": true }]
            }
        }
    ]
}
